# Copy to .env and fill in values before `docker compose up`.

# Session auth (either name works)
ASSISTANT_API_KEY=
# OH_SESSION_API_KEYS_0=

LLM_API_KEY=
LLM_MODEL=openai/gpt-4o
# LLM_BASE_URL=

# Headless Google search (no Search API key). Default true.
# GOOGLE_SEARCH_ENABLED=true

# Optional overrides
# ASSISTANT_IMAGE=ghcr.io/eldadfux/openhands:dev
# ASSISTANT_PORT=8000
# ASSISTANT_UI_IMAGE=ghcr.io/eldadfux/openhands-ui:dev
# ASSISTANT_UI_PORT=3001
