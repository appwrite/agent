# Copy to .env and fill in values before `docker compose up`.

ASSISTANT_API_KEY=
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o
# LLM_BASE_URL=

# Headless web search (no Search API key). Default true.
# WEB_SEARCH_ENABLED=true

# MCP OAuth redirect base (browser-facing origin; usually the UI).
# Callback path: {MCP_OAUTH_REDIRECT_BASE}/api/mcp/oauth/callback
# MCP_OAUTH_REDIRECT_BASE=http://localhost:3001
# MCP_OAUTH_CLIENT_NAME=Appwrite Assistant

# Optional overrides
# ASSISTANT_IMAGE=ghcr.io/eldadfux/openhands:dev
# ASSISTANT_PORT=8000
# ASSISTANT_UI_IMAGE=ghcr.io/eldadfux/openhands-ui:dev
# ASSISTANT_UI_PORT=3001
