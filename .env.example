# Copy to .env and fill in values before `docker compose up`.

ASSISTANT_API_KEY=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6
# LLM_BASE_URL=

# Headless web search (no Search API key). Default true.
# WEB_SEARCH_ENABLED=true

# Inline chat attachments (base64 in the turn request)
# ATTACHMENTS_MAX_BYTES=10000000
# ATTACHMENTS_MAX_PER_MESSAGE=8

# SSE tool payload caps (Cloud persists these)
# STREAM_TOOL_INPUT_CHARS=100000
# STREAM_TOOL_OUTPUT_CHARS=500000

# Optional overrides
# ASSISTANT_IMAGE=ghcr.io/eldadfux/openhands:dev
# ASSISTANT_PORT=8000
# ASSISTANT_UI_IMAGE=ghcr.io/eldadfux/openhands-ui:dev
# ASSISTANT_UI_PORT=3001
